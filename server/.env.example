#############################################
# EduManage - Server environment example
# Copy to `.env` and fill real secrets (DO NOT check .env into git)
#############################################

# Server
PORT=5000

# MongoDB connection string (mongodb://user:pass@host:port/db or mongodb+srv://...)
MONGO_URI=

# JWT
JWT_SECRET=
# JWT expiration (e.g. 7d, 1h)
JWT_EXPIRES_IN=7d

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Admin seed credentials (provide one admin only)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePasswordHere
ADMIN_ROLE=super_admin

# Uploads
UPLOADS_PATH=uploads
MAX_FILE_SIZE_BYTES=10485760  # 10 MB

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Other
NODE_ENV=development
# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/edumanage

# ---- JWT ----
JWT_SECRET=replace_this_with_a_long_random_64_char_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=edumanage_token

# ---- CORS ----
CLIENT_URL=http://localhost:5173

# ---- Seed Admins (used ONLY by seeds/seedAdmins.js, never in source code) ----
SUPER_ADMIN_EMAIL=superadmin@edumanage.local
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin123!
CONTENT_ADMIN_EMAIL=contentadmin@edumanage.local
CONTENT_ADMIN_PASSWORD=ChangeMe_ContentAdmin123!
FACULTY_ADMIN_EMAIL=facultyadmin@edumanage.local
FACULTY_ADMIN_PASSWORD=ChangeMe_FacultyAdmin123!

# ---- Uploads ----
MAX_FILE_SIZE_MB=15
